{
  "name": "csfd-ratings-everywhere",
  "description": "Unofficial browser extension that turns ČSFD links into clickable links with the film's rating.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Tomas Hulek",
  "repository": "github:tohu12/csfd-ratings-everywhere",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && playwright test",
    "bench": "vitest bench --run",
    "size": "size-limit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "postinstall": "wxt prepare",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv2 --warnings-as-errors"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.5"
  }
}
